<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The debug-only intranet keyboard update (setup-page URL,
         plain http + unsigned zip) needs cleartext. Release builds keep the
         main manifest's usesCleartextTraffic="false". -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <activity
            android:name=".ModelSmokeTestActivity"
            android:exported="true" />
    </application>
</manifest>
